# Supabase (local defaults from `supabase start`; swap for your cloud project when deploying)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional overflow database for large area_stats datasets (src/lib/db/stores.ts).
# Unset = everything lives in DATABASE_URL, as in the local stack.
NEON_DATABASE_URL=
# Size budget `npm run db:rebalance` keeps the primary database under, in MB.
SUPABASE_LIMIT_MB=480
SUPABASE_TARGET_MB=450
# Largest single file the data lake uploads to Supabase Storage, in MB.
STORAGE_MAX_UPLOAD_MB=50

# Neo4j (local defaults from infra/docker/docker-compose.yml; swap for Neo4j Aura when deploying)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=worldview-dev

# Bearer token required on POST /api/ingest/batch — the shared secret a data
# collection agent presents as `Authorization: Bearer <INGEST_API_KEY>`.
# Generate one with: openssl rand -hex 32
INGEST_API_KEY=

# Congress.gov API key — for the legislation importers (import:congress-bills /
# import:congress-votes). Free at https://api.congress.gov/sign-up/ (an
# api.data.gov key; DEMO_KEY also works at a low rate limit). The weekly
# sync runs in GitHub Actions (.github/workflows/sync-legislation.yml) with
# this plus DATABASE_URL / NEO4J_* set as repo secrets.
CONGRESS_GOV_API_KEY=

# Other api.data.gov keys for the money and crime importers. All optional;
# without them the importers fall back to DEMO_KEY's low rate limit.
FEC_API_KEY=
FBI_API_KEY=
LDA_API_KEY=

# Optional normalized civic-roster provider for state, county, municipal,
# school-board, prosecutor, sheriff, and judicial officeholders. The endpoint
# receives ?address= and returns { "officials": [...] }; requests use a bearer
# token when CIVIC_OFFICIALS_API_KEY is set. Without it, My Government still
# resolves Census districts and current members of Congress, and labels all
# remaining officeholder records as unresolved rather than guessing.
CIVIC_OFFICIALS_API_URL=
CIVIC_OFFICIALS_API_KEY=

# Census Data API key — for scripts/import-acs.mjs. Free at
# https://api.census.gov/data/key_signup.html (not an api.data.gov key).
CENSUS_API_KEY=

# Optional NASA FIRMS key for the Geography studio's near-real-time active
# fire layer. Free keys are issued at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# and are used only by the server-side provider route, never exposed to clients.
NASA_FIRMS_MAP_KEY=

# AISStream key used only by the long-running `npm run ingest:ais` worker.
# The key never reaches a browser; Geography reads normalized snapshots from
# Postgres through its provider route.
AISSTREAM_API_KEY=
# Optional subscription box as south,west,north,east. Defaults to the world.
AIS_BOUNDING_BOX=

# Auth (docs/auth-plan.md). Registration is open; new accounts are members,
# and `npm run auth:role -- <email> editor` grants shared-data editing.
# Cloudflare Turnstile site key; set together with Supabase's captcha secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local only: Google OAuth client for supabase/config.toml [auth.external.google].
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional: address shown as "Request access" on /datasets/publish for
# institutions that want to publish data (docs/data-hosting.md).
DATA_PARTNERS_CONTACT=

# Public contact address used by the footer and policy pages. If omitted,
# those links use the project's public GitHub issue tracker.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional direct destination for Atlas's Faith & Christian Tradition card.
# Optional override. The default links directly to /learn/denomination-quiz with ref attribution.
NEXT_PUBLIC_EVERYCHURCH_QUIZ_URL=

# The one account allowed into the Geography studio (/geography). Unset = nobody.
OWNER_EMAIL=

# Writ close-races ingest (scripts/sync-ga-results.mjs, docs/writ-close-races-runbook.md).
# Operator alerts: a Slack or Discord webhook, or an ntfy.sh topic URL for phone push.
ALERT_WEBHOOK_URL=
# After each write the ingester calls SITE_URL/api/writ/revalidate with this
# bearer secret so the report shows new numbers immediately. Same value in
# the site's env and wherever the ingester runs.
SITE_URL=
REVALIDATE_SECRET=
