# Supabase (local defaults from `supabase start`; swap for your cloud project when deploying)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Neo4j (local defaults from infra/docker/docker-compose.yml; swap for Neo4j Aura when deploying)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=worldview-dev

# Claude — used only for the on-demand "Analyze this" action, never a background pipeline
ANTHROPIC_API_KEY=

# Bearer token required on POST /api/ingest/batch — the shared secret a data
# collection agent presents as `Authorization: Bearer <INGEST_API_KEY>`.
# Generate one with: openssl rand -hex 32
INGEST_API_KEY=

# Congress.gov API key — for the legislation importers (import:congress-bills /
# import:congress-votes). Free at https://api.congress.gov/sign-up/ (an
# api.data.gov key; DEMO_KEY also works at a low rate limit). The weekly
# sync runs in GitHub Actions (.github/workflows/sync-legislation.yml) with
# this plus DATABASE_URL / NEO4J_* set as repo secrets.
CONGRESS_GOV_API_KEY=
