# Supabase (local defaults from `supabase start`; swap for your cloud project when deploying)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Neo4j (local defaults from infra/docker/docker-compose.yml; swap for Neo4j Aura when deploying)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=worldview-dev

# Claude — used only for the on-demand "Analyze this" action, never a background pipeline
ANTHROPIC_API_KEY=

# Bearer token required on POST /api/ingest/batch — the shared secret a data
# collection agent presents as `Authorization: Bearer <INGEST_API_KEY>`.
# Generate one with: openssl rand -hex 32
INGEST_API_KEY=

# Congress.gov API key — for the legislation importers (import:congress-bills /
# import:congress-votes). Free at https://api.congress.gov/sign-up/ (an
# api.data.gov key; DEMO_KEY also works at a low rate limit). The weekly
# sync runs in GitHub Actions (.github/workflows/sync-legislation.yml) with
# this plus DATABASE_URL / NEO4J_* set as repo secrets.
CONGRESS_GOV_API_KEY=

# Optional normalized civic-roster provider for state, county, municipal,
# school-board, prosecutor, sheriff, and judicial officeholders. The endpoint
# receives ?address= and returns { "officials": [...] }; requests use a bearer
# token when CIVIC_OFFICIALS_API_KEY is set. Without it, My Government still
# resolves Census districts and current members of Congress, and labels all
# remaining officeholder records as unresolved rather than guessing.
CIVIC_OFFICIALS_API_URL=
CIVIC_OFFICIALS_API_KEY=

# Census Data API key — for scripts/import-acs.mjs. Free at
# https://api.census.gov/data/key_signup.html (not an api.data.gov key).
CENSUS_API_KEY=

# Auth (docs/auth-plan.md). New accounts need REGISTRATION_CODE on /register;
# leave it empty to close registration. The real value lives in .env.local /
# .env.cloud and the deploy environment — don't commit it here.
REGISTRATION_CODE=
# "true" once the Google provider is configured in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
# Cloudflare Turnstile site key; set together with Supabase's captcha secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local only: Google OAuth client for supabase/config.toml [auth.external.google].
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
