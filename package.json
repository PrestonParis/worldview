{
  "name": "worldview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs && (node scripts/migrate.mjs || echo 'migrate: local DB unreachable, skipped')",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "node scripts/migrate.mjs --if-vercel-production && next build",
    "start": "next start -p 3001",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --check package.json playwright.config.ts tests/e2e 'src/app/api/data/v1/**/*.ts' 'src/components/atlas/**/*.{ts,tsx}' 'src/components/ui/**/*.{ts,tsx}' 'src/components/demographics/{demographics-forecast,forecast-model}.{ts,tsx}' 'src/components/money/money-flow*.{ts,tsx}' src/components/quiz/quiz-runner.tsx 'src/lib/actions/**/*.ts' 'src/lib/atlas/{profile,profile-schema,specialists}*.ts' 'src/lib/browser/**/*.ts' 'src/lib/data/**/*.ts' 'src/lib/db/stats.ts' 'src/lib/db/stats/**/*.ts' src/lib/validation/observation.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "infra:up": "supabase start && docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down && supabase stop",
    "infra:status": "supabase status && docker compose -f infra/docker/docker-compose.yml ps",
    "env:cloud": "cp .env.cloud .env.local && echo '✓ Switched to cloud Supabase (worldview project). Run: npm run dev'",
    "env:docker": "cp .env.local.docker .env.local && echo '✓ Switched to local Docker Supabase. Run: npm run infra:up && npm run dev'",
    "env:status": "grep NEXT_PUBLIC_SUPABASE_URL .env.local | sed 's/NEXT_PUBLIC_SUPABASE_URL=/Supabase target: /'",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed.mjs",
    "db:export": "node scripts/export-db.mjs",
    "db:restore-postgres": "node scripts/restore-postgres-backup.mjs",
    "import:fec-donors": "node scripts/import-fec-donors.mjs",
    "import:lda-lobbying": "node scripts/import-lda-lobbying.mjs",
    "import:congress-bills": "node scripts/import-congress-bills.mjs",
    "import:congress-votes": "node scripts/import-congress-votes.mjs",
    "import:elections": "node scripts/import-elections.mjs",
