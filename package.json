{
  "name": "worldview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "infra:up": "supabase start && docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down && supabase stop",
    "infra:status": "supabase status && docker compose -f infra/docker/docker-compose.yml ps",
    "env:cloud": "cp .env.cloud .env.local && echo '✓ Switched to cloud Supabase (worldview project). Run: npm run dev'",
    "env:docker": "cp .env.local.docker .env.local && echo '✓ Switched to local Docker Supabase. Run: npm run infra:up && npm run dev'",
    "env:status": "grep NEXT_PUBLIC_SUPABASE_URL .env.local | sed 's/NEXT_PUBLIC_SUPABASE_URL=/Supabase target: /'",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed.mjs",
    "db:export": "node scripts/export-db.mjs",
    "db:restore-postgres": "node scripts/restore-postgres-backup.mjs",
    "db:migrate-neo4j": "node scripts/migrate-neo4j.mjs",
    "db:migrate-people-categories": "node scripts/migrate-people-categories.mjs",
    "import:fec-donors": "node scripts/import-fec-donors.mjs",
    "import:lda-lobbying": "node scripts/import-lda-lobbying.mjs",
    "import:congress-bills": "node scripts/import-congress-bills.mjs",
    "import:congress-votes": "node scripts/import-congress-votes.mjs",
    "import:elections": "node scripts/import-elections.mjs",
    "import:county-results": "node scripts/import-county-results.mjs",
    "backfill:members": "node scripts/backfill-members.mjs",
    "backfill:donor-fields": "node scripts/backfill-donor-fields.mjs",
    "reconstruct:fec-graph": "node scripts/reconstruct-fec-graph.mjs",
    "db:apply": "drizzle-kit push --force",
    "import:fec-cycle": "node scripts/import-fec-cycle.mjs",
    "import:fec-totals": "node scripts/import-fec-cycle.mjs --totals-only",
    "db:apply-sql": "node scripts/apply-sql.mjs",
    "import:committees": "node scripts/import-congress-committees.mjs",
    "import:voteview": "node scripts/import-voteview.mjs",
    "import:openstates": "node scripts/import-openstates-people.mjs",
    "import:acs": "node scripts/import-acs.mjs",
    "import:federal-register": "node scripts/import-federal-register.mjs",
    "import:scdb": "node scripts/import-scdb.mjs",
    "import:fec-ie": "node scripts/import-fec-independent-expenditures.mjs",
    "import:usaspending": "node scripts/import-usaspending.mjs",
    "import:fbi-crime": "node scripts/import-fbi-crime.mjs",
    "import:cbp": "node scripts/import-cbp-encounters.mjs",
    "import:eavs": "node scripts/import-eavs.mjs",
    "import:all": "bash scripts/import-all.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@turf/turf": "^7.4.0",
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "konva": "^10.3.0",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.2.0",
    "neo4j-driver": "^6.2.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-konva": "^19.2.5",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
