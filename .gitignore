# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# database backups — local dumps written by scripts/export-db.mjs and
# scripts/migrate-neo4j.mjs, plus the reconstruct script's FEC response
# cache. Two snapshots are committed as the recovery record: the pre-wipe
# Postgres backup and the full Neo4j graph (see each dir's manifest).
/backups/*
!/backups/2026-09-06T21-05-25/
!/backups/2026-09-07T00-12-neo4j-full/

# claude code — machine-local settings, not shared
.claude/
.claude/settings.local.json

# election import cache — large MEDSL source files fetched on demand by
# scripts/import-elections.mjs. The small topline files it uses by default
# are committed under data/elections/ directly.
/data/elections/cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# demographics build download cache
/.cache/
.neon

# AI agent instructions — kept local, not published
CLAUDE.md
AGENTS.md
/exports/
